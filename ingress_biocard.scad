// Fixed-size Ingress biocard; user-supplied SVG contours are embedded below.
// Bed Z=0, front +Z. No SVG files or third-party libraries required.
/* [Frame] */
base_thickness = 1.6; // [1.2:0.2:3.2]
bottom_band = 19; // [18:1:24]
corner_chamfer = 0.4; // [0:0.1:1]
top_right_cut = 6; // [4:0.5:8]

/* [Identity] */
codename = "AgentName";
location = "CHINA";
faction = "Resistance"; // [Resistance, Enlightened]
font_name = "Liberation Sans:style=Bold"; // font
agentname_spacing = 0.5; // [0.4:0.1:2]
detail_spacing = 0.5; // [0.4:0.1:2]

/* [Content and Colors] */
content_mode = "Raised"; // [Raised, Inset]
accent_height = 0.6; // [0.4:0.2:1.2]
layer_height = 0.2; // [0.1:0.05:0.3]
body_color = "#F5F1E8"; // color
use_faction_color = true;
resistance_color = "#168BD2"; // color
enlightened_color = "#39B54A"; // color
accent_color = "#168BD2"; // color
export_part = "Assembly"; // [Assembly, Base, Accent]

/* [Hidden] */
card_width = 63;
card_height = 88;
border_width = 4;
margin = 1;
// A union of radius-0.24 disks gives a nominal feature width of at least 0.48.
feature_radius = 0.24;
header_logo_height = 11.2;
header_text_height = header_logo_height/2;
header_logo_width = 0.8718039317237192*header_logo_height;
header_word_width = 5.400746712645637*header_text_height; // Replaced by the measured normalized SVG width when bundled.
header_logo_y = card_height-margin-header_logo_height;
header_word_x = margin+header_logo_width+1;
header_word_y = card_height-margin-header_text_height;
faction_logo_height = bottom_band-2*margin;
faction_logo_width = (faction == "Resistance" ? 0.6667097381085872 : 0.5969356255981507)*
    faction_logo_height;
identity_box_width = card_width-border_width-margin-3-
    0.6667097381085872*faction_logo_height;
content_z = content_mode == "Inset" ? base_thickness-accent_height : base_thickness;
$fn = 64;
accent_hex = use_faction_color ?
    (faction == "Resistance" ? resistance_color : enlightened_color) : accent_color;

module validate() {
    assert(card_width == 63 && card_height == 88, "Card dimensions are fixed");
    assert(border_width == 4, "Frame width is fixed at 4 mm");
    assert(feature_radius == 0.24, "Minimum printable feature setting is fixed");
    assert(bottom_band >= 18 && bottom_band <= 24, "Invalid information band height");
    assert(corner_chamfer >= 0 && corner_chamfer <= 1, "Invalid corner chamfer");
    assert(top_right_cut >= 4 && top_right_cut <= 8, "Invalid top-right cut");
    assert(faction == "Resistance" || faction == "Enlightened", "Unknown faction");
    assert(content_mode == "Raised" || content_mode == "Inset", "Unknown content mode");
    assert(agentname_spacing >= 0.4 && agentname_spacing <= 2 &&
        detail_spacing >= 0.4 && detail_spacing <= 2, "Letter gaps must be 0.4–2 mm");
    assert(export_part == "Assembly" || export_part == "Base" || export_part == "Accent",
        "Unknown export part");
    assert(base_thickness >= 1.2 && accent_height >= 0.4, "Insufficient thickness");
    assert(content_mode != "Inset" || base_thickness-accent_height >= 0.8,
        "Inset requires at least 0.8 mm solid backing");
    assert(layer_height > 0 &&
        abs(base_thickness/layer_height-round(base_thickness/layer_height)) < 0.001 &&
        abs(accent_height/layer_height-round(accent_height/layer_height)) < 0.001,
        "Thicknesses must be whole layer multiples");
    if (content_mode == "Raised")
        echo(str("First accent layer=", round(base_thickness/layer_height)+1));
    else echo("Inset: AMS / multipart printing required; front is flush");
    children();
}

module outline_2d() {
    c=corner_chamfer; t=top_right_cut;
    polygon([[c,0],[card_width-c,0],[card_width,c],
        [card_width,card_height-t],[card_width-t,card_height],
        [c,card_height],[0,card_height-c],[0,c]]);
}

// The lower-left hex edge and both opening ramps have slope tan(30).
function window_points() =
    let(s=tan(30),
        logo_support=header_logo_y+header_logo_height*-0.2550080312966625-s*margin,
        ramp_support=logo_support-margin/cos(30),
        low_roof=header_word_y-margin,
        high_roof=card_height-border_width,
        first_end=(low_roof-ramp_support)/s,
        second_start=header_word_x+header_word_width+(margin/cos(30)-margin)/s,
        second_end=second_start+(high_roof-low_roof)/s,
        clip_shift=border_width*(sqrt(2)-1))
    [[border_width,bottom_band],[card_width-border_width,bottom_band],
     [card_width-border_width,card_height-top_right_cut-clip_shift],
     [card_width-top_right_cut-clip_shift,high_roof],
     [second_end,high_roof],[second_start,low_roof],
     [first_end,low_roof],[border_width,ramp_support+s*border_width]];

module window_2d() { polygon(window_points()); }
module frame_2d() { difference() { outline_2d(); window_2d(); } }

// Scale first, then dilate: shrinking cannot reduce the final 0.48 mm feature.
module ink_2d() { offset(r=0.16) children(); }
module core_2d() {
    offset(r=feature_radius) offset(r=-feature_radius) ink_2d() children();
}
module repair_2d() {
    // Opening rounds unsupported tips while retaining a union of 0.48 mm disks.
    core_2d() children();
}

module fixed_header_2d() {
    translate([margin,header_logo_y])
        ingress_symbol_2d(header_logo_height);
    translate([header_word_x,header_word_y])
        ingress_wordmark_2d(header_text_height);
}
module faction_badge_2d() {
    translate([card_width-margin-faction_logo_width,margin])
        if (faction == "Resistance") resistance_symbol_2d(faction_logo_height);
        else enlightened_symbol_2d(faction_logo_height);
}
// textmetrics() is required: use a current development build locally.
// Equal gaps refer to visible ink bounds, rather than font advance/kerning.
function glyph_metrics(c) = textmetrics(c,size=10,font=font_name);
function glyph_width(c) = c == " " ? glyph_metrics(c).advance.x : glyph_metrics(c).size.x;
function raw_width(value,n=undef,i=0) =
    let(end=is_undef(n)?len(value):n)
    i>=end ? 0 : glyph_width(value[i])+raw_width(value,end,i+1);
function line_metrics(value) = textmetrics(value,size=10,font=font_name);
function line_scale(value,height,gap) = len(value)==0 ? 0 :
    let(m=line_metrics(value), n=len(value), p=feature_radius,
        available=identity_box_width-2*p*n-gap*(n-1))
    assert(!is_undef(m),"Enable textmetrics in OpenSCAD development build")
    assert(m.size.y>0 && available>0,"Text has no visible glyphs or is too long")
    min((height-2*p)/m.size.y,available/raw_width(value));
function line_height(value,height,gap) = len(value)==0 ? 0 :
    line_metrics(value).size.y*line_scale(value,height,gap)+2*feature_radius;
function identity_lines() = [location, faction == "Resistance" ? "RESISTANCE" : "ENLIGHTENED",codename];
function identity_heights() = [for(i=[0:2]) line_height(identity_lines()[i],i==2?8.2:3.6,
    i==2?agentname_spacing:detail_spacing)];
function identity_row_gap() = (bottom_band-2*margin-identity_heights()[0]-
    identity_heights()[1]-identity_heights()[2])/2;
module label_2d(value,height,gap) {
    if (len(value)>0) {
        m=line_metrics(value); k=line_scale(value,height,gap); p=feature_radius;
        assert(k>=0.07,"Text too long to retain printable, separate letters");
        for(i=[0:len(value)-1]) if(value[i]!=" ") {
            g=glyph_metrics(value[i]);
            translate([raw_width(value,i)*k+i*(2*p+gap)+p-g.position.x*k,
                p-m.position.y*k])
                // Dilation alone is a union of 0.48 mm disks, preserving all glyph tips.
                // Its exact extent is raw ink bounds +0.24 mm on each side.
                offset(r=p) scale([k,k])
                    text(value[i],size=10,font=font_name,halign="left",valign="baseline");
        }
    }
}
module identity_2d() {
    h=identity_heights(); g=identity_row_gap();
    assert(g>=0.4,"Information band too short for separate lines");
    translate([border_width,margin]) {
        label_2d(location,3.6,detail_spacing);
        translate([0,h[0]+g]) label_2d(identity_lines()[1],3.6,detail_spacing);
        translate([0,h[0]+h[1]+2*g]) label_2d(codename,8.2,agentname_spacing);
    }
}
module marks_2d() {
    // No intersection() clipping: the complete glyphs and artwork are retained.
    union() { fixed_header_2d(); faction_badge_2d(); identity_2d(); }
}
module accent_part() {
    translate([0,0,content_z]) linear_extrude(accent_height) marks_2d();
}
module base_part() {
    difference() {
        linear_extrude(base_thickness) frame_2d();
        if (content_mode == "Inset") accent_part();
    }
}

